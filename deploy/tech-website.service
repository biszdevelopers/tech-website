[Unit]
Description=Tech-Website (Node 24 SSR)
After=network.target

[Service]
Type=simple
# Run as a dedicated non-root user:
#   sudo useradd -r -s /usr/sbin/nologin techweb
#   sudo chown -R techweb:techweb /opt/tech-website
User=techweb
WorkingDirectory=/opt/tech-website
EnvironmentFile=/opt/tech-website/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --env-file=/opt/tech-website/.env dist/server.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tech-website

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/tech-website/prisma /opt/tech-website/var

[Install]
WantedBy=multi-user.target
