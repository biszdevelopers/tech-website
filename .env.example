# Database (SQLite via Drizzle + better-sqlite3)
DATABASE_URL_MAIN="file:./data/main.db"
DATABASE_URL_WEB="file:./data/web.db"

# Public origin. REQUIRED in production; used for CSRF, redirects and Stripe.
SITE_ORIGIN="http://localhost:3000"

# Session secrets - REQUIRED (app refuses to boot without them)
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars
SESSION_SECRET_WEB=change-me-to-another-random-string-at-least-32-chars
SESSION_TTL_SECONDS=1800

# Set to true when a trusted reverse proxy supplies X-Forwarded-For and
# X-Forwarded-Proto. Required when https is terminated before Node.
TRUST_PROXY=false

# Runtime uploads and generated social cards (outside dist/, survive builds)
UPLOADS_DIR=var/uploads
OG_DIR=var/og

# Optional in-process TLS. Leave empty when a proxy terminates TLS.
TLS_CERT=
TLS_KEY=

# Optional 32-byte base64 key for AES-GCM encryption of DB secrets.
# Generate with: openssl rand -base64 32
SETTINGS_KEY=

# Directory operator login (read from .env at boot; restart after changes)
# Use a long random value (16+ characters). It is never stored in SQLite.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Feature flags (true/false). Everything can be turned off here.
FEATURE_PAYMENTS=true
FEATURE_WHEEL=true
FEATURE_AFFILIATE=true
FEATURE_GIFTCARDS=true
FEATURE_IPSTRESS=true

# Payments - Stripe only. Checkout fails closed without the webhook secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
