<%- include('partials/dash-head', { title: 'News Management', crumb: 'News' }) %>
<div class="container-fluid">
    <div class="row">
        <div class="col-md-5">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Create Announcement</h4>
                    <form class="mt-4" action="/web/api/admin/news" method="POST">
                        <input type="hidden" name="action" value="create"/>
                        <div class="form-group"><label class="text-white">Title</label><input class="form-control" required name="title"/></div>
                        <div class="form-group"><label class="text-white">Content</label><textarea class="form-control" name="content" rows="4" required></textarea></div>
                        <button type="submit" class="btn btn-success">Publish</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">All Announcements</h4>
                    <div class="table-responsive mt-4">
                        <table class="table">
                            <thead><tr><th>ID</th><th>Title</th><th>Date</th><th>Actions</th></tr></thead>
                            <tbody>
                                <% if (news.length === 0) { %>
                                    <tr><td colSpan="4" class="text-center text-muted">No announcements yet.</td></tr>
                                <% } else { news.forEach(function (n) { %>
                                    <tr>
                                        <td><%= n.ID %></td>
                                        <td><%= n.title %></td>
                                        <td><%= n.date %></td>
                                        <td>
                                            <details>
                                                <summary class="btn btn-sm btn-primary">Edit</summary>
                                                <form class="mt-3" action="/web/api/admin/news" method="POST">
                                                    <input type="hidden" name="action" value="update"/>
                                                    <input type="hidden" name="id" value="<%= n.ID %>"/>
                                                    <input class="form-control mb-1" name="title" value="<%= n.title %>" required/>
                                                    <textarea class="form-control mb-1" name="content" rows="4" required><%= n.content %></textarea>
                                                    <button class="btn btn-sm btn-success" type="submit">Save</button>
                                                </form>
                                            </details>
                                            <form action="/web/api/admin/news" method="POST" class="mt-1">
                                                <input type="hidden" name="action" value="delete"/>
                                                <input type="hidden" name="id" value="<%= n.ID %>"/>
                                                <button class="btn btn-sm btn-danger" type="submit">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('partials/dash-foot') %>
