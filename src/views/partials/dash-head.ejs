<%- include('head', { title: title + ' · IPstress', css: ['webtheme.css', 'dash.css'], scripts: ['menu.js'] }) %>
<div id="main-wrapper" data-theme="dark" data-layout="vertical" data-navbarbg="skin6"
     data-sidebartype="full" data-sidebar-position="fixed" data-header-position="fixed" data-boxed-layout="full">
    <header class="topbar" data-navbarbg="skin6">
        <nav class="navbar top-navbar navbar-dark">
            <div class="navbar-header" data-logobg="skin6">
                <button type="button" class="nav-toggler" aria-label="Toggle menu"><span aria-hidden="true"></span></button>
                <div class="navbar-brand">
                    <b class="logo-icon text-center"><img src="/images/logo-icon.png" alt="homepage" class="dark-logo"/></b>
                    <b class="text-center text-white brand-title">IPstress</b>
                </div>
            </div>
            <div class="navbar-collapse collapse" id="navbarSupportedContent">
                <ul class="navbar-nav float-left mr-auto ml-3 pl-1"></ul>
                <ul class="navbar-nav float-right">
                    <li class="nav-item">
                        <button id="theme-toggle" class="web-theme-toggle" type="button"
                                aria-label="Toggle dark mode" aria-pressed="false" title="Toggle dark mode (Alt+T)">
                            <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="4"></circle>
                                <line x1="12" y1="2" x2="12" y2="5"></line>
                                <line x1="12" y1="19" x2="12" y2="22"></line>
                                <line x1="4.2" y1="4.2" x2="6.3" y2="6.3"></line>
                                <line x1="17.7" y1="17.7" x2="19.8" y2="19.8"></line>
                                <line x1="2" y1="12" x2="5" y2="12"></line>
                                <line x1="19" y1="12" x2="22" y2="12"></line>
                                <line x1="4.2" y1="19.8" x2="6.3" y2="17.7"></line>
                                <line x1="17.7" y1="6.3" x2="19.8" y2="4.2"></line>
                            </svg>
                            <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
                            </svg>
                        </button>
                    </li>
                    <li class="nav-item dropdown">
                        <button type="button" class="nav-link dropdown-toggle" data-toggle="dropdown">
                            <img src="/images/logo-icon.png" alt="homepage" class="dark-logo" width="29"/>
                            <span class="ml-2 d-none d-lg-inline-block"><span class="text-white">Hello, Admin!</span></span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-right user-dd animated flipInY">
                            <a class="dropdown-item" href="/web/admin/tickets">Inbox</a>
                            <a class="dropdown-item" href="/web/profile">Profile</a>
                            <a class="dropdown-item" href="/web">View site</a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="/web/api/auth/logout">Logout</a>
                        </div>
                    </li>
                </ul>
            </div>
        </nav>
    </header>
    <aside class="left-sidebar" data-sidebarbg="skin6">
        <div class="scroll-sidebar">
            <nav class="sidebar-nav">
                <ul id="sidebarnav">
                    <li class="nav-small-cap"><span class="hide-menu">Admin Panel</span></li>
                    <% [
                        { href: '/web/admin/dashboard',  icon: 'home',    label: 'Dashboard' },
                        { href: '/web/admin/users',      icon: 'users',   label: 'Users' },
                        { href: '/web/admin/plans',      icon: 'lock',    label: 'Plans' },
                        { href: '/web/admin/tickets',    icon: 'mail',    label: 'Tickets' },
                        { href: '/web/admin/attacklogs', icon: 'wifioff', label: 'Attack Logs' },
                        { href: '/web/admin/loginlogs',  icon: 'user',    label: 'Login Logs' },
                        { href: '/web/admin/news',       icon: 'plus',    label: 'News' },
                        { href: '/web/admin/giftcards',  icon: 'plus',    label: 'Gift Cards' },
                        { href: '/web/admin/settings',   icon: 'settings',label: 'Settings' },
                        { href: '/web/admin/servers',    icon: 'shield',  label: 'API Servers' },
                        { href: '/web/admin/methods',    icon: 'plus',    label: 'Methods' },
                        { href: '/web/admin/hub',        icon: 'power',   label: 'Hub' },
                    ].forEach(function (it) { %>
                        <li class="sidebar-item">
                            <a class="sidebar-link" href="<%= it.href %>">
                                <%- include('feather', { name: it.icon }) %>
                                <span class="hide-menu"><%= it.label %></span>
                            </a>
                        </li>
                    <% }) %>
                </ul>
            </nav>
        </div>
    </aside>
    <div class="page-wrapper">
        <div class="page-breadcrumb">
            <div class="d-flex align-items-center">
                <h4 class="page-title text-truncate text-white font-weight-medium mb-0"> <%= title %> </h4>
                <div class="ml-auto">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb m-0 p-0">
                            <li class="breadcrumb-item text-sql">IPstress</li>
                            <li class="breadcrumb-item text-muted"><%= crumb %></li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
