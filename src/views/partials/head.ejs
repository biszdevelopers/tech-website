<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <% if (locals.description) { %>
    <meta name="description" content="<%= description %>" />
    <% } %>
    <link rel="icon" href="/images/favicon.png?v=<%= v %>" />
    <% (locals.css || ['globals.css']).forEach(function (file) { %>
    <link rel="stylesheet" href="/css/<%= file %>?v=<%= v %>" />
    <% }) %>
    <% var allScripts = ['theme.js', 'img-fallback.js', 'scroll-top.js'].concat(locals.scripts || []); %>
    <link rel="preload" href="/fonts/noto-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script src="/js/legacy/theme-boot.js?v=<%= v %>"></script>
    <script nomodule src="/js/vendor/ie11-custom-properties.js?v=<%= v %>"></script>
    <script nomodule src="/js/legacy/ie11.js?v=<%= v %>"></script>
    <script nomodule src="/js/legacy/ie-detect.js?v=<%= v %>"></script>
    <% allScripts.forEach(function (file) { %>
    <script type="module" src="/js/modern/<%= file %>?v=<%= v %>"></script>
    <script nomodule src="/js/legacy/<%= file %>?v=<%= v %>" defer></script>
    <% }) %>
</head>
<body>
