<%- include('partials/head', { title: 'Operator Login | BIBS-C Tech Tools', description: 'Operator sign in.', css: ['site.css', 'forms.css'], robots: 'noindex,nofollow' }) %>
<%- include('partials/navbar') %>

<div id="main">
    <div id="big">
        <h1 id="login-heading">Operator sign in</h1>
        <div id="login">
            <h2 id="login-info">Enter your credentials to continue.</h2>
            <% if (locals.error === 'invalid') { %>
            <p id="login-error" role="alert">Invalid username or password.</p>
            <% } else if (locals.error === 'rate') { %>
            <p id="login-error" role="alert">Too many attempts. Wait a minute and try again.</p>
            <% } %>
            <form id="login-form" method="post" action="/api/auth/login">
                <label class="field"><span>Username</span>
                    <input type="text" placeholder="Username" required name="username" autocomplete="username" maxlength="120"/>
                </label>
                <label class="field"><span>Password</span>
                    <input type="password" placeholder="Password" required name="password" autocomplete="current-password" maxlength="200"/>
                </label>
                <button type="submit">Login</button>
            </form>
        </div>
    </div>
</div>

</body>
</html>
