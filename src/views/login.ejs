<%- include('partials/head', { title: 'Login | BIBS-C Tech Tools', css: ['globals.css', 'login.css'] }) %>
<%- include('partials/navbar') %>

<div id="main">
    <div id="big">
        <h1 id="login-heading">Sign in</h1>
        <div id="login">
            <h2 id="login-info">Enter your credentials to continue.</h2>
            <% if (locals.error === 'invalid') { %>
            <p id="login-error" role="alert">Invalid username or password.</p>
            <% } else if (locals.error === 'rate') { %>
            <p id="login-error" role="alert">Too many attempts. Wait a minute and try again.</p>
            <% } %>
            <form id="login-form" method="post" action="/api/auth/login">
                <p><input type="text" placeholder="Username" aria-label="Username" required name="username"/></p>
                <p><input type="password" placeholder="Password" aria-label="Password" required name="password"/></p>
                <button type="submit">Login</button>
            </form>
        </div>
    </div>
</div>

</body>
</html>
