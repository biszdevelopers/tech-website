<%- include('partials/head', { title: tool.techname + ' | BIBS-C Tech Tools', description: String(tool.tl1_desc || tool.tl2_desc || tool.tl3_desc || tool.displaytext).slice(0, 160), css: ['site.css'], image: tool.ogImage }) %>
<%- include('partials/navbar') %>

<div id="subhead">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span>
        <a href="/search">Tools</a><span aria-hidden="true">/</span>
        <span aria-current="page"><%= tool.techname %></span>
    </nav>
    <h1 id="tool-heading"><%= tool.techname %></h1>
    <p class="jump-menu"> Jump to:
        <% tlSections.forEach(function (section) { %>
        | <a href="#<%= section.id %>"><%= section.shortLabel %></a>
        <% }) %>
        | <a href="/search">Search</a> | <a href="/">Home</a></p>
</div>

<div id="bar">&nbsp;</div>

<div id="all">
    <div class="techtip-wrap" id="results">
        <article class="techtip tool-detail" id="tool-<%= tool.id %>">
            <div class="line" id="line-<%= tool.id %>"></div>
            <h2 class="name"><%= tool.techname %></h2>
            <div class="tags">
                <% strands.forEach(function (t) { %>
                <a href="/<%= t.tl %>/<%= t.slug %>"><span class="<%= t.css %>"><%= t.label %></span></a>
                <% }) %>
            </div>
            <div class="info">
                <div class="img"><img src="/uploads/<%= tool.id %>?v=<%= tool.updatedAt %>" width="96" height="96" alt="<%= tool.techname %>" data-fallback loading="lazy" decoding="async"/></div>
                <div class="desc">
                    <% tlSections.forEach(function (section) { %>
                    <section id="<%= section.id %>">
                        <h2><%= section.title %></h2>
                        <p><%= section.description || 'Not documented for this strategy yet.' %></p>
                    </section>
                    <% }) %>
                    <div class="link">
                        <ul><li><a href="<%= tool.link %>" target="_blank" rel="noreferrer"><%= tool.displaytext %></a></li></ul>
                        <% if (resources.length > 0) { %>
                        <ul class="resource-list">
                            <% resources.forEach(function (resource) { %>
                            <li><a href="<%= resource.url %>" target="_blank" rel="noreferrer"><%= resource.label %></a></li>
                            <% }) %>
                        </ul>
                        <% } %>
                    </div>
                </div>
            </div>
        </article>
    </div>
</div>

<button id="topbutton" title="Go to top">Top</button>

<%- include('partials/footer') %>
</body>
</html>
