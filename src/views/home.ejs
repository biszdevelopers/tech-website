<%- include('partials/head', { title: 'BIBS-C Tech Tools | Teaching and Learning Technology Directory', description: 'A curated directory of teaching technology tools organized across the six Teaching and Learning domains.', css: ['site.css'] }) %>
<%- include('partials/navbar') %>

<div id="front" data-built-by="richie-rich90454">
    <img alt="Abstract hand-drawn welcome illustration" fetchpriority="high" decoding="async"
         class="hero-media" src="/images/hero.svg" width="1600" height="900"/>
    <div aria-hidden="true" class="hero-shade"></div>
    <h1>Welcome to BASIS International and Bilingual Schools China Tech Tools</h1>
</div>

<div id="bar">&nbsp;</div>

<div id="all">
    <div id="basicinfo">
        <h2 id="about" class="section-anchor">About this site</h2>
        <p> Before you start using this site, you&#39;ll want to take a moment to understand how it is organized. </p>
        <p> This website presents technological tools you can use to aid your instruction. These <b>Tech Tools</b> are
            sorted into six <b>domains</b> based on their function (see below). Within each domain, Tech Tools are then
            sorted into <b>strands</b> based on how they help you accomplish each step in implementing the broader
            educational strategy. Each domain has its own page with filters and a strand index. </p>
        <h2 id="strategies">The Six Domains of Teaching and Learning (TL):</h2>
        <p id="jump-menu" class="jump-menu"> Jump to:
            <% cards.forEach(function (card, i) { %><% if (i > 0) { %> | <% } %><a href="/#<%= card.id %>"><%= card.shortLabel %> (<%= card.id.toUpperCase() %>)</a><% }) %>
            | <a href="/#submit-cta">Submit a Tool</a> | <a href="/#footer">Footer</a></p>
    </div>
</div>

<div class="tl-section" id="domains">
    <% cards.forEach(function (card) { %>
    <a class="tlx" id="<%= card.id %>" href="<%= card.href %>">
        <div class="tlhead"><%= card.title %></div>
        <div class="tlx__strands-label"><%= card.strands.length ? 'Includes the strands' : 'Covers the standards' %></div>
        <ul class="tlx__strands">
            <% card.items.forEach(function (item) { %>
            <li><%= item %></li>
            <% }) %>
        </ul>
    </a>
    <% }) %>
</div>

<p class="tl-submit-cta" id="submit-cta">
    In addition, if you know of any tech tools not already on this site, you may submit them here:
    <a class="submit-link" href="/submission">Submit New Tech Tool</a> </p>

<%- include('partials/footer') %>
</body>
</html>
