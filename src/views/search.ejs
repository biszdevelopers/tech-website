<%- include('partials/head', { title: heading + ' | BIBS-C Tech Tools', description: 'Search teaching technology tools by name, description, strand or submitter.', css: ['site.css'] }) %>
<%- include('partials/navbar') %>

<div id="subhead">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span>
        <span aria-current="page">Search</span>
    </nav>
    <h1 id="search-results"><%= heading %></h1>
    <form id="search-form" class="search-form" action="/search" method="get">
        <input type="text" id="search-input" placeholder="Search tech tools by name, description, strand or tag..." aria-label="Search tech tools" name="query" value="<%= q %>" maxlength="200"/>
        <button type="submit" id="search-submit">Search</button>
    </form>
    <% if (q) { %>
    <p class="search-meta"><%= resultCount %> <%= resultCount === 1 ? 'result' : 'results' %></p>
    <% } %>
    <p class="jump-menu">
        Jump to: <a href="#search-results">Results</a><% if (q && results.length > 0) {
            results.slice(0, 5).forEach(function (item, i) { %>
            | <a href="#tool-<%= item.id %>"><%= item.techname %></a><% }) } %>
        | <a href="/#front">Home</a>
    </p>
</div>

<div id="bar">&nbsp;</div>

<div id="all">
    <div class="techtip-wrap" id="results">
        <% if (!q) { %>
        <div class="empty-state"><h2>Type a search term above to look up a tool.</h2></div>
        <% } else if (results.length === 0) { %>
        <div class="empty-state"><h2>No tools match &ldquo;<%= q %>&rdquo;.</h2></div>
        <% } else { results.forEach(function (item) {
               var tags = item.activeTags;
               var display = tags.slice(0, 5);
               var hidden = tags.slice(5); %>
        <article class="techtip search-result" id="tool-<%= item.id %>">
            <div class="line" id="line-<%= item.id %>"></div>
            <h2 class="name"><a href="<%= item.path %>"><%= item.techname %></a></h2>
            <div class="tags">
                <% display.forEach(function (t) { %>
                <a href="/<%= t.tl %>/<%= t.slug %>"><span class="<%= t.css %>"><%= t.label %></span></a>
                <% }) %>
                <% if (hidden.length > 0) { %>
                <span class="tags-more">and <%= hidden.length %> more...</span>
                <% } %>
            </div>
            <div class="info">
                <div class="img"><a href="<%= item.path %>"><img src="/uploads/<%= item.id %>?v=<%= item.updatedAt %>" width="96" height="96" alt="<%= item.techname %>" data-fallback loading="lazy" decoding="async"/></a></div>
                <div class="desc">
                    <% tlList.forEach(function (config) { var field = config.id + '_desc'; var t = String(item[field] || ''); var i = t.toLowerCase().indexOf(q.toLowerCase()); %>
                    <% if (q && i >= 0) { %><p><b><%= config.shortLabel %>:</b> <%= t.slice(0, i) %><mark><%= t.slice(i, i + q.length) %></mark><%= t.slice(i + q.length) %></p>
                    <% } else if (t) { %><p><b><%= config.shortLabel %>:</b> <%= t %></p><% } %>
                    <% }) %>
                    <div class="link">
                        <ul><li><a href="<%= item.link %>" target="_blank" rel="noreferrer"><%= item.displaytext %></a></li></ul>
                        <% if (item.resources.length > 0) { %>
                        <ul class="resource-list">
                            <% item.resources.forEach(function (resource) { %>
                            <li><a href="<%= resource.url %>" target="_blank" rel="noreferrer"><%= resource.label %></a></li>
                            <% }) %>
                        </ul>
                        <% } %>
                    </div>
                </div>
            </div>
        </article>
        <% }) } %>
    </div>
</div>

<button id="topbutton" title="Go to top">Top</button>

<%- include('partials/footer') %>
</body>
</html>
