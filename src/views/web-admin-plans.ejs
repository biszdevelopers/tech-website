<%- include('partials/dash-head', { title: 'Plan Management', crumb: 'Plans' }) %>
<div class="container-fluid">
    <div class="row">
        <div class="col-md-5">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Create Plan</h4>
                    <form class="mt-4" action="/web/api/admin/plans" method="POST">
                        <input type="hidden" name="action" value="create"/>
                        <div class="form-group"><label class="text-white">Name</label><input class="form-control" required name="name"/></div>
                        <div class="form-group"><label class="text-white">Price (USD)</label><input class="form-control" type="number" step="0.01" min="0.01" required name="price"/></div>
                        <div class="form-group"><label class="text-white">Duration</label><input class="form-control" type="number" min="1" required name="length"/><select class="form-control" name="unit"><option value="days">Days</option><option value="hours">Hours</option></select></div>
                        <div class="form-group"><label class="text-white">Max Attack Time (s)</label><input class="form-control" type="number" min="1" max="3600" required name="mbt"/></div>
                        <div class="form-group"><label class="text-white">Concurrents</label><input class="form-control" type="number" min="1" required name="concurrents"/></div>
                        <div class="form-group"><label class="text-white">VIP</label><select class="form-control" name="vip"><option value="0">No</option><option value="1">Yes</option></select></div>
                        <div class="form-group"><label class="text-white">Private</label><select class="form-control" name="private"><option value="0">No</option><option value="1">Yes</option></select></div>
                        <button type="submit" class="btn btn-success">Create Plan</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">All Plans</h4>
                    <div class="table-responsive mt-4">
                        <table class="table">
                            <thead><tr><th>ID</th><th>Name</th><th>Price</th><th>Length</th><th>Actions</th></tr></thead>
                            <tbody>
                                <% if (plans.length === 0) { %>
                                    <tr><td colSpan="5" class="text-center text-muted">No plans created yet.</td></tr>
                                <% } else { plans.forEach(function (pl) { %>
                                    <tr>
                                        <td><%= pl.ID %></td>
                                        <td><%= pl.name %></td>
                                        <td>$<%= pl.price %></td>
                                        <td><%= pl.length %> <%= pl.unit %></td>
                                        <td>
                                            <details>
                                                <summary class="btn btn-sm btn-primary">Edit</summary>
                                                <form class="mt-3" action="/web/api/admin/plans" method="POST">
                                                    <input type="hidden" name="action" value="update"/>
                                                    <input type="hidden" name="id" value="<%= pl.ID %>"/>
                                                    <input class="form-control mb-1" name="name" value="<%= pl.name %>" required/>
                                                    <input class="form-control mb-1" type="number" step="0.01" min="0.01" name="price" value="<%= pl.price %>"/>
                                                    <input class="form-control mb-1" type="number" min="1" name="length" value="<%= pl.length %>"/>
                                                    <select class="form-control mb-1" name="unit">
                                                        <option value="days"<%- pl.unit === 'days' ? ' selected' : '' %>>Days</option>
                                                        <option value="hours"<%- pl.unit === 'hours' ? ' selected' : '' %>>Hours</option>
                                                    </select>
                                                    <input class="form-control mb-1" type="number" min="1" max="3600" name="mbt" value="<%= pl.mbt %>"/>
                                                    <input class="form-control mb-1" type="number" min="1" name="concurrents" value="<%= pl.concurrents %>"/>
                                                    <select class="form-control mb-1" name="vip"><option value="0"<%- !pl.vip ? ' selected' : '' %>>No VIP</option><option value="1"<%- pl.vip ? ' selected' : '' %>>VIP</option></select>
                                                    <select class="form-control mb-1" name="private"><option value="0"<%- !pl.private ? ' selected' : '' %>>Public</option><option value="1"<%- pl.private ? ' selected' : '' %>>Private</option></select>
                                                    <button class="btn btn-sm btn-success" type="submit">Save</button>
                                                </form>
                                            </details>
                                            <form action="/web/api/admin/plans" method="POST" class="mt-1">
                                                <input type="hidden" name="action" value="delete"/>
                                                <input type="hidden" name="id" value="<%= pl.ID %>"/>
                                                <button class="btn btn-sm btn-danger" type="submit">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('partials/dash-foot') %>
