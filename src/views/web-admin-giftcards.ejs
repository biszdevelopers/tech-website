<%- include('partials/dash-head', { title: 'Gift Cards', crumb: 'Gift Cards' }) %>
<div class="container-fluid">
    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Generate Codes</h4>
                    <form class="mt-4" action="/web/api/admin/giftcards" method="POST">
                        <input type="hidden" name="action" value="generate"/>
                        <div class="form-group">
                            <label class="text-white">Plan</label>
                            <select class="form-control" name="planID" required>
                                <option value="">Select a plan...</option>
                                <% plans.forEach(function (pl) { %>
                                    <option value="<%= pl.ID %>"><%= pl.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="text-white">Number of codes</label>
                            <input class="form-control" type="number" min="1" max="100" required name="count" value="1"/>
                        </div>
                        <button type="submit" class="btn btn-success">Generate</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">All Gift Cards</h4>
                    <div class="table-responsive mt-4">
                        <table class="table">
                            <thead><tr><th>ID</th><th>Code</th><th>Plan</th><th>Claimed By</th><th>Created</th><th>Actions</th></tr></thead>
                            <tbody>
                                <% if (cards.length === 0) { %>
                                    <tr><td colSpan="6" class="text-center text-muted">No gift cards yet.</td></tr>
                                <% } else { cards.forEach(function (c) { %>
                                    <tr>
                                        <td><%= c.ID %></td>
                                        <td><code><%= c.code %></code></td>
                                        <td><%= c.planID %></td>
                                        <td><%= c.claimedby > 0 ? c.claimedby : (c.claimedby === -1 ? 'Revoked' : '-') %></td>
                                        <td><%= new Date(Number(c.date) * 1000).toLocaleDateString('en-US') %></td>
                                        <td>
                                            <% if (Number(c.claimedby) === 0) { %>
                                            <details>
                                                <summary class="btn btn-sm btn-primary">Edit</summary>
                                                <form class="mt-2" action="/web/api/admin/giftcards" method="POST">
                                                    <input type="hidden" name="action" value="update"/>
                                                    <input type="hidden" name="id" value="<%= c.ID %>"/>
                                                    <select class="form-control mb-1" name="planID">
                                                        <% plans.forEach(function (pl) { %>
                                                        <option value="<%= pl.ID %>"<%- Number(c.planID) === pl.ID ? ' selected' : '' %>><%= pl.name %></option>
                                                        <% }) %>
                                                    </select>
                                                    <button class="btn btn-sm btn-success" type="submit">Save</button>
                                                </form>
                                            </details>
                                            <form action="/web/api/admin/giftcards" method="POST" class="mt-1">
                                                <input type="hidden" name="action" value="revoke"/>
                                                <input type="hidden" name="id" value="<%= c.ID %>"/>
                                                <button class="btn btn-sm btn-warning" type="submit">Revoke</button>
                                            </form>
                                            <% } %>
                                            <% if (Number(c.claimedby) <= 0) { %>
                                            <form action="/web/api/admin/giftcards" method="POST" class="mt-1">
                                                <input type="hidden" name="action" value="delete"/>
                                                <input type="hidden" name="id" value="<%= c.ID %>"/>
                                                <button class="btn btn-sm btn-danger" type="submit">Delete</button>
                                            </form>
                                            <% } else { %>
                                            <span class="text-muted">Claimed</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('partials/dash-foot') %>
