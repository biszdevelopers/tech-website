<%- include('partials/head', { title: config.title + ' | BIBS-C Tech Tools', description: config.description, css: ['site.css'], scripts: ['filters.js'] }) %>
<%- include('partials/navbar') %>

<div id="subhead">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span>
        <% if (locals.activeStrand) { %>
        <a href="/<%= tl %>"><%= config.title %></a><span aria-hidden="true">/</span>
        <span aria-current="page"><%= activeStrand.label %></span>
        <% } else { %>
        <span aria-current="page"><%= config.title %></span>
        <% } %>
    </nav>
    <h1 id="tl-title"><%= locals.activeStrand ? activeStrand.label : config.title %></h1>
    <p class="tl-description"><%= config.description %></p>
    <% if (locals.activeStrand) { %>
    <p class="strand-active"><span>Showing only:</span> <%= activeStrand.label %>.
        <a href="/<%= tl %>">View all strands</a></p>
    <% } %>

    <details class="tl-standards" open>
        <summary>What this domain covers</summary>
        <ul>
            <% config.standards.forEach(function (standard) { %><li><%= standard %></li><% }) %>
        </ul>
    </details>

    <% if (config.strands.length > 0) { %>
    <h2 id="filter" class="filter-heading">Filter by strand:</h2>
    <form class="filters" action="/<%= tl %>" method="get">
        <% config.strands.forEach(function (strand, i) { %>
        <label class="label" id="<%= strand.domainColumn %>">
            <input type="hidden" name="<%= strand.checkboxName %>" value="0"/>
            <span class="<%= strand.cssClass %>"><%= strand.label %>
                <input type="checkbox" class="checkf" aria-label="<%= strand.label %>" name="<%= strand.checkboxName %>"<%- checked[i] ? ' checked=""' : '' %> value="1"/>
            </span>
            <span class="overlay"><%= strand.tooltip %></span>
        </label>
        <% }) %>
        <button type="submit" class="filter-apply">Apply filters</button>
        <a class="filter-reset" href="/<%= tl %>">Reset</a>
    </form>

    <nav class="strand-index" aria-label="Browse by strand">
        <% strandLinks.forEach(function (link) { %>
        <a href="<%= link.href %>"><%= link.label %></a>
        <% }) %>
    </nav>
    <% } else if (locals.writeupFilters) { %>
    <h2 id="filter" class="filter-heading">Filter by strand and category:</h2>
    <form class="filters filters--writeup" action="/<%= tl %>" method="get">
        <fieldset class="filter-group">
            <legend>Strand</legend>
            <% writeupFilters.strandGroups.forEach(function (group) { %>
            <p class="filter-group__label"><%= group.title %></p>
            <div class="filter-chips">
                <% group.options.forEach(function (option) { %>
                <label class="label">
                    <input type="hidden" name="<%= option.name %>" value="0"/>
                    <span class="<%= option.cssClass %>"><%= option.label %>
                        <input type="checkbox" class="checkf" aria-label="<%= option.label %>" name="<%= option.name %>"<%- option.checked ? ' checked=""' : '' %> value="1"/>
                    </span>
                    <span class="overlay"><%= option.tooltip %></span>
                </label>
                <% }) %>
            </div>
            <% }) %>
        </fieldset>
        <fieldset class="filter-group">
            <legend>Category</legend>
            <div class="filter-chips">
                <% writeupFilters.categories.forEach(function (option) { %>
                <label class="label">
                    <input type="hidden" name="<%= option.name %>" value="0"/>
                    <span class="cat"><%= option.label %>
                        <input type="checkbox" class="checkf" aria-label="<%= option.label %>" name="<%= option.name %>"<%- option.checked ? ' checked=""' : '' %> value="1"/>
                    </span>
                </label>
                <% }) %>
            </div>
        </fieldset>
        <div class="filter-actions">
            <button type="submit" class="filter-apply">Apply filters</button>
            <a class="filter-reset" href="/<%= tl %>">Reset</a>
        </div>
    </form>
    <% } %>
</div>

<div id="bar">&nbsp;</div>

<div id="all">
    <div class="techtip-wrap" id="results">
        <p class="jump-menu">
            Jump to: <a href="#tl-title">Top</a><% if (config.strands.length > 0 || locals.writeupFilters) { %> | <a href="#filter">Filter</a><% } %> | <a href="/search">Search</a> | <a href="/">Home</a>
        </p>

        <% if (filtered.length === 0) { %>
        <div class="empty-state">
            <h2>No tools here yet.</h2>
            <% if (config.strands.length === 0) { %>
            <p>This domain is ready for write-ups. Add them in the admin panel or submit a tool with a <%= config.shortLabel %> description.</p>
            <% } else { %>
            <p>No accepted tools match the selected strands. Try <a href="/<%= tl %>">resetting the filters</a>.</p>
            <% } %>
        </div>
        <% } else { filtered.forEach(function (tool) { %>
        <article class="techtip" id="tool-<%= tool.id %>">
            <div class="line" id="line-<%= tool.id %>"></div>
            <h2 class="name"><a href="<%= tool.path %>"><%= tool.techname %></a></h2>
            <div class="tags">
                <% tagOptions.forEach(function (tag) { if (tool.tags[tag.domainColumn]) { %>
                <a href="<%= tag.href %>"><span class="<%= tag.cssClass %>"><%= tag.label %></span></a>
                <% } }) %>
                <% tool.categories.forEach(function (category) { var categoryIndex = config.topics.indexOf(category); %>
                <% if (categoryIndex >= 0) { %>
                <a href="/<%= tl %>?cat_<%= categoryIndex + 1 %>=1"><span class="cat"><%= category %></span></a>
                <% } %>
                <% }) %>
            </div>
            <div class="info">
                <div class="img"><a href="<%= tool.path %>"><img src="/uploads/<%= tool.id %>?v=<%= tool.updatedAt %>" width="96" height="96" alt="<%= tool.techname %>" data-fallback loading="lazy" decoding="async"/></a></div>
                <div class="desc"><% if (tool.tight) { %><%= tool.desc %><% } else { %> <%= tool.desc %> <% } %></div>
                <div class="link">
                    <ul><li><a href="<%= tool.link %>" target="_blank" rel="noreferrer"><%= tool.displaytext %></a></li></ul>
                    <% if (tool.resources.length > 0) { %>
                    <ul class="resource-list">
                        <% tool.resources.forEach(function (resource) { %>
                        <li><a href="<%= resource.url %>" target="_blank" rel="noreferrer"><%= resource.label %></a></li>
                        <% }) %>
                    </ul>
                    <% } %>
                </div>
            </div>
        </article>
        <% }) } %>
    </div>
</div>

<button id="topbutton" title="Go to top">Top</button>

<%- include('partials/footer') %>
</body>
</html>
