<%- include('partials/head', { title: 'Submit A New Tech Tool | BIBS-C Tech Tools', description: 'Suggest a teaching technology tool for the BIBS-C directory.', robots: 'noindex,nofollow', css: ['site.css', 'forms.css'] }) %>
<%- include('partials/navbar') %>

<div id="subhead">
    <h1 id="submission-heading">Submit A New Tech Tool</h1>
    <p class="jump-menu"> Jump to: <a href="#tool-name">Tool Name</a> | <a href="#tool-link">Link</a> |
        <a href="#descriptions">Descriptions</a> | <a href="#domains">Strands</a> |
        <a href="#resources">Resources</a> | <a href="#screenshot">Screenshot</a> | <a href="/#front">Home</a></p>
</div>

<div id="bar">&nbsp;</div>

<div id="all">
    <div id="form-wrap">
    <% if (locals.received) { %>
    <p class="submit-success" role="status">Thanks! Your submission was received and is waiting for review.</p>
    <% } %>
    <% if (locals.error) { %>
    <p class="form-error" role="alert"><%= locals.error %></p>
    <% } %>
    <% var v = locals.values || {}; %>
    <form id="form" action="/api/submission" enctype="multipart/form-data" method="post">
        <input type="hidden" name="website" value=""/>
        <h2 id="tool-name">Tool Name:</h2>
        <input type="text" class="l" placeholder="Name of Tool" name="techname" required maxlength="160" value="<%= v.techname || '' %>"/>

        <h2 id="tool-link">Link:</h2>
        <input type="url" class="l" placeholder="https://..." name="link" required maxlength="2048" value="<%= v.link || '' %>"/>

        <h2>Display Text for Link:</h2>
        <input type="text" class="l" placeholder="Display Text" name="displaytext" required maxlength="200" value="<%= v.displaytext || '' %>"/>

        <h2 id="descriptions">Teaching and Learning Descriptions:</h2>
        <% tlList.forEach(function (config) { var field = config.id + '_desc'; %>
        <label class="field"><span><%= config.title %></span>
            <textarea name="<%= field %>" class="l" maxlength="8000" placeholder="<%= config.shortLabel %> description..."><%= v[field] || '' %></textarea>
        </label>
        <% if (config.id === 'tl5' || config.id === 'tl6') { %>
        <p class="form-hint">Optional: choose the <%= config.shortLabel.toLowerCase() %> categories this tool supports.</p>
        <div class="domains">
            <% config.topics.forEach(function (topic, index) { var categoryField = config.id + '_c' + (index + 1); %>
            <label><input type="checkbox" name="<%= categoryField %>" value="true"<%- v[categoryField] === 'true' ? ' checked=""' : '' %>/><%= topic %></label>
            <% }) %>
        </div>
        <% } %>
        <% }) %>

        <h2 id="domains">Strands:</h2>
        <% tlList.forEach(function (config) { if (config.strands.length === 0) return; %>
        <h3 class="form-subhead"><%= config.title %></h3>
        <div class="domains">
            <% config.strands.forEach(function (strand) { %>
            <label><input type="checkbox" name="<%= strand.domainColumn %>" value="true"<%- v[strand.domainColumn] === 'true' ? ' checked=""' : '' %>/><%= strand.label %></label>
            <% }) %>
        </div>
        <% }) %>

        <h2 id="resources">Additional resources (optional):</h2>
        <label class="field"><span>One per line: Label | https://...</span>
            <textarea name="resources" class="l" rows="4" maxlength="20000" placeholder="Manual | https://example.com/guide"><%= v.resources || '' %></textarea>
        </label>

        <h2>Your Name (optional):</h2>
        <input type="text" class="l" placeholder="Your Name" name="username" maxlength="120" value="<%= v.username || '' %>"/>

        <h2>Contact Email (optional):</h2>
        <input type="text" class="l" placeholder="Contact Email" name="contact" maxlength="200" value="<%= v.contact || '' %>"/>

        <h2 id="screenshot">Upload screenshot:</h2>
        <input type="file" accept="image/png,image/jpeg,image/webp" name="screenshot"/>
        <p class="form-hint">PNG, JPEG or WebP, up to 10 MB. If the form reports an error, choose the file again.</p>

        <input type="submit" class="submit-btn" value="Submit"/>
    </form>
    </div>
</div>

<%- include('partials/footer') %>
</body>
</html>
