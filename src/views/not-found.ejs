<%- include('partials/head', { title: 'Not Found | BIBS-C Tech Tools' }) %>
<%- include('partials/navbar') %>

<div id="wrap">
    <section class="notice-page">
        <p class="notice-page__code">404</p>
        <h1>Page not found</h1>
        <p>That page doesn't exist. Check the address or head back to the tools.</p>

        <% if (suggestions.length > 0) { %>
        <h2>Tools matching your request</h2>
        <ul class="notice-page__list">
            <% suggestions.forEach(function (s) { %>
            <li><a href="/tool/<%= s.id %>"><%= s.techname %></a></li>
            <% }) %>
        </ul>
        <% } %>

        <p class="notice-page__actions">
            <a class="notice-page__btn" href="/">Home</a>
            <a class="notice-page__btn notice-page__btn--ghost" href="/search">Search all tools</a>
        </p>
    </section>
</div>

<%- include('partials/footer') %>
</body>
</html>
