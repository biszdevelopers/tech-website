<%- include('partials/head', { title: 'New Submission | BIBS-C Tech Tools', robots: 'noindex,nofollow', css: ['site.css', 'forms.css', 'admin.css'] }) %>
<%- include('partials/navbar') %>
<div id="adminTopbar"><h1>New Tech Tool</h1></div>
<div id="adminNav">
    <ul>
        <li><a href="/admin">&#8592; Back to Admin</a></li>
    </ul>
</div>
<div id="wrap">
    <form id="form" method="post" action="/api/admin/create" enctype="multipart/form-data">
        <h2>Tool details</h2>
        <div class="form-grid">
            <label class="field"><span>Tool name</span>
                <input class="l" type="text" name="techname" required maxlength="160"/>
            </label>
            <label class="field"><span>Link</span>
                <input class="l" type="url" name="link" placeholder="https://..." required maxlength="2048"/>
            </label>
            <label class="field"><span>Display text</span>
                <input class="l" type="text" name="displaytext" required maxlength="200"/>
            </label>
        </div>

        <h2>Descriptions</h2>
        <% descriptionColumns.forEach(function (column) { %>
        <label class="field"><span><%= column.label %></span>
            <textarea class="l" name="<%= column.field %>" maxlength="8000"></textarea>
        </label>
        <% }) %>

        <h2>Strands</h2>
        <div class="domains">
            <% strands.forEach(function (s) { %>
            <label><input type="checkbox" name="<%= s.name %>"/><%= s.label %></label>
            <% }) %>
        </div>

        <h2>Categories</h2>
        <% categoryGroups.forEach(function (group) { %>
        <h3 class="form-subhead"><%= group.title %></h3>
        <div class="domains">
            <% group.options.forEach(function (option) { %>
            <label><input type="checkbox" name="<%= option.name %>"/><%= option.label %></label>
            <% }) %>
        </div>
        <% }) %>

        <h2>Additional resources</h2>
        <label class="field"><span>One per line: Label | https://...</span>
            <textarea class="l" name="resources" rows="4" placeholder="Manual | https://example.com/guide"></textarea>
        </label>

        <h2>Submission details</h2>
        <div class="form-grid">
            <label class="field"><span>Submitter name</span>
                <input class="l" type="text" name="username" maxlength="120"/>
            </label>
            <label class="field"><span>Contact email</span>
                <input class="l" type="text" name="contact" maxlength="200"/>
            </label>
            <label class="field"><span>Screenshot (PNG, JPEG or WebP, max 10 MB)</span>
                <input type="file" name="screenshot" accept="image/png,image/jpeg,image/webp"/>
            </label>
        </div>

        <label class="check"><input type="checkbox" name="accepted"/> Publish immediately</label>
        <button type="submit" class="submit-btn">Create Tool</button>
    </form>
</div>
</body>
</html>
