<%- include('partials/head', { title: 'New Submission · BIBS·C Tech Tools' }) %>
<%- include('partials/navbar') %>
<div id="adminTopbar"><h1>New Tech Tool</h1></div>
<div id="adminNav">
    <ul>
        <li><a href="/admin">&#8592; Back to Admin</a></li>
    </ul>
</div>
<form method="post" action="/api/admin/create" enctype="multipart/form-data">
    <table>
        <thead>
            <tr>
                <th>Tool Name</th><th>TL1 Description</th><th>TL2 Description</th>
                <th>TL3 Description</th><th>TL4 Description</th><th>Link</th><th>Display Text</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><textarea name="techname" required></textarea></td>
                <td><textarea name="tl1_desc"></textarea></td>
                <td><textarea name="tl2_desc"></textarea></td>
                <td><textarea name="tl3_desc"></textarea></td>
                <td><textarea name="tl4_desc"></textarea></td>
                <td><textarea name="link" required placeholder="https://..."></textarea></td>
                <td><textarea name="displaytext" required></textarea></td>
            </tr>
        </tbody>
    </table>
    <p><label>Submitter name <input type="text" name="username"/></label></p>
    <p><label>Contact email <input type="text" name="contact"/></label></p>
    <p><label>Screenshot (PNG, JPEG or WebP) <input type="file" name="screenshot" accept="image/png,image/jpeg,image/webp"/></label></p>
    <p><label><input type="checkbox" name="accepted"/> Publish immediately</label></p>
    <h3>Strands</h3>
    <ul>
        <% strands.forEach(function (s) { %>
            <li>
                <input type="checkbox" name="<%= s.name %>"/>
                <span><%= s.label %></span>
            </li>
        <% }) %>
    </ul>
    <button type="submit">Create Tool</button>
</form>
</body>
</html>
