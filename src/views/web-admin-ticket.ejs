<%- include('partials/dash-head', { title: 'Ticket #' + ticket.id, crumb: 'Tickets | #' + ticket.id }) %>
<div class="container-fluid">
    <div class="row">
        <div class="col-lg-9 mx-auto">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="card-title mb-0"><%= ticket.subject %></h4>
                        <span class="badge badge-info"><%= ticket.status %></span>
                    </div>
                    <p class="text-muted mb-1">From <b><%= ticket.username %></b> on
                        <%= new Date(Number(ticket.date) * 1000).toLocaleString('en-US') %></p>
                    <div class="ticket-thread">
                        <div class="ticket-message">
                            <p><%= ticket.content %></p>
                        </div>
                        <% (messages || []).forEach(function (m) { %>
                        <div class="ticket-message <%- m.sender === ticket.username ? '' : 'ticket-message--staff' %>">
                            <div class="ticket-message__meta"><b><%= m.sender %></b>
                                <span><%= new Date(Number(m.date) * 1000).toLocaleString('en-US') %></span>
                            </div>
                            <p><%= m.content %></p>
                        </div>
                        <% }) %>
                    </div>
                    <form class="mt-4" action="/web/api/admin/tickets" method="POST">
                        <input type="hidden" name="id" value="<%= ticket.id %>"/>
                        <div class="form-group">
                            <label class="text-white" for="reply">Reply as admin</label>
                            <textarea class="form-control" id="reply" name="content" rows="4" required></textarea>
                        </div>
                        <button class="btn btn-primary" type="submit" name="action" value="reply">Send Reply</button>
                        <% if (ticket.status === 'Closed') { %>
                        <button class="btn btn-secondary" type="submit" name="action" value="reopen" formnovalidate>Reopen</button>
                        <% } else { %>
                        <button class="btn btn-warning" type="submit" name="action" value="close" formnovalidate>Close</button>
                        <% } %>
                        <button class="btn btn-danger" type="submit" name="action" value="delete" formnovalidate>Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('partials/dash-foot') %>
