<%- include('partials/head', { title: 'Plans | IPstress', css: ['webtheme.css'] }) %>
<%- include('partials/web-header') %>
<div class="page-breadcrumb">
    <div class="d-flex align-items-center">
        <h4 class="page-title text-truncate text-white font-weight-medium mb-0">Plans</h4>
        <div class="ml-auto">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb m-0 p-0">
                    <li class="breadcrumb-item text-sql" aria-current="page">IPstress</li>
                    <li class="breadcrumb-item text-muted" aria-current="page">Plans</li>
                </ol>
            </nav>
        </div>
    </div>
</div>
<div class="container-fluid">
    <% if (locals.error) { %>
    <p class="alert alert-warning" role="alert">Checkout is temporarily unavailable. Please try again later.</p>
    <% } %>
    <div class="row">
        <% plans.forEach(function (p) { %>
            <div class="col-md-4 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <h5 class="text-center text-uppercase mt-3 mb-4"><%= p.name %></h5>
                        <h3 class="text-center font-weight-light">$<%= p.price %></h3>
                        <p class="text-muted text-center mb-4 font-weight-light">
                            Duration: <%= p.length %>
                            <%= p.unit === 'hours' ? (p.length === 1 ? 'hour' : 'hours') : (p.length === 1 ? 'day' : 'days') %>
                        </p>
                        <div class="d-flex align-items-center mb-2">
                            <p> Max Attack Time: <b><%= p.mbt %>s</b> </p>
                        </div>
                        <div class="d-flex align-items-center mb-2">
                            <p> Concurrents: <b><%= p.concurrents %></b> </p>
                        </div>
                        <div class="d-flex align-items-center mb-2">
                            <p> <b>Unlimited Attacks</b> </p>
                        </div>
                        <div class="d-flex align-items-center mb-2">
                            <p> VIP:
                                <% if (Number(p.vip)) { %>
                                    <span class="plan-yes">Yes</span>
                                <% } else { %>
                                    <span class="plan-no">No</span>
                                <% } %>
                            </p>
                        </div>
                        <% if (locals.signedIn) { %>
                        <form method="post" action="/web/api/payments/stripe">
                            <input type="hidden" name="plan" value="<%= p.ID %>"/>
                            <button class="btn btn-success btn-lg w-100 fw-bold mb-3" type="submit">Buy Now</button>
                        </form>
                        <% } else { %>
                        <p class="text-muted">Sign-in is required to purchase a plan.</p>
                        <% } %>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
</div>
</body>
</html>
