<%- include('partials/head', { title: 'Affiliate | IPstress', css: ['webtheme.css'] }) %>
<%- include('partials/web-header') %>
<div class="page-breadcrumb">
    <div class="d-flex align-items-center">
        <h4 class="page-title text-truncate text-white font-weight-medium mb-0"> Affiliate </h4>
        <div class="ml-auto">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb m-0 p-0">
                    <li class="breadcrumb-item text-sql" aria-current="page">IPstress</li>
                    <li class="breadcrumb-item text-muted" aria-current="page"> Affiliate </li>
                </ol>
            </nav>
        </div>
    </div>
</div>
<div class="container-fluid">
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Affiliate Stats</h4>
                    <div class="mt-4 activity">
                        <% if (locals.stats) { %>
                        <table class="table">
                            <tbody>
                                <tr>
                                    <td>Referral link</td>
                                    <td class="referral-link"><%= stats.referralLink %></td>
                                </tr>
                                <tr>
                                    <td>Referred users</td>
                                    <td><%= stats.referralCount %></td>
                                </tr>
                                <tr>
                                    <td>Referral balance</td>
                                    <td><%= stats.referralBalance %>&#165;</td>
                                </tr>
                            </tbody>
                        </table>
                        <% } else { %>
                        <p class="text-muted">Sign in to see your referral link and balance.</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">How it works</h4>
                    <div class="mt-4 activity">
                        <p class="text-muted">Share your referral link with other operators. When
                            someone registers through it and buys a plan, the commission is credited
                            to your referral balance.</p>
                        <p class="text-muted mb-0">Withdrawals are handled by support. Open a ticket
                            with your payout method and address.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>
