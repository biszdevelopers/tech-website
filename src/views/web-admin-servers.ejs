<%- include('partials/dash-head', { title: 'API Server Management', crumb: 'API Servers' }) %>
<div class="container-fluid">
    <div class="row">
        <div class="col-md-5">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Add API Server</h4>
                    <form class="mt-4" action="/web/api/admin/servers" method="POST">
                        <input type="hidden" name="action" value="create"/>
                        <div class="form-group"><label class="text-white">Name</label><input class="form-control" required name="name"/></div>
                        <div class="form-group"><label class="text-white">API URL template</label><input class="form-control" required name="api" placeholder="https://api.example.com/attack?host=[host]&amp;port=[port]&amp;time=[time]&amp;method=[method]"/></div>
                        <div class="form-group"><label class="text-white">Slots</label><input class="form-control" type="number" min="1" required name="slots" value="10"/></div>
                        <div class="form-group"><label class="text-white">Methods (comma separated)</label><input class="form-control" name="methods" value="UDP,TCP"/></div>
                        <div class="form-group"><label class="text-white">VIP only</label><select class="form-control" name="vip"><option value="0">No</option><option value="1">Yes</option></select></div>
                        <button type="submit" class="btn btn-success">Add Server</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">All API Servers</h4>
                    <div class="table-responsive mt-4">
                        <table class="table">
                            <thead><tr><th>ID</th><th>Name</th><th>Slots</th><th>Methods</th><th>Actions</th></tr></thead>
                            <tbody>
                                <% if (servers.length === 0) { %>
                                    <tr><td colSpan="5" class="text-center text-muted">No servers added yet.</td></tr>
                                <% } else { servers.forEach(function (s) { %>
                                    <tr>
                                        <td><%= s.id %></td>
                                        <td><%= s.name %></td>
                                        <td><%= s.slots %></td>
                                        <td><%= s.methods %></td>
                                        <td>
                                            <details>
                                                <summary class="btn btn-sm btn-primary">Edit</summary>
                                                <form class="mt-3" action="/web/api/admin/servers" method="POST">
                                                    <input type="hidden" name="action" value="update"/>
                                                    <input type="hidden" name="id" value="<%= s.id %>"/>
                                                    <input class="form-control mb-1" name="name" value="<%= s.name %>" required/>
                                                    <input class="form-control mb-1" name="api" value="<%= s.api %>"/>
                                                    <input class="form-control mb-1" type="number" name="slots" value="<%= s.slots %>"/>
                                                    <input class="form-control mb-1" name="methods" value="<%= s.methods %>"/>
                                                    <select class="form-control mb-1" name="vip"><option value="0"<%- !s.vip ? ' selected' : '' %>>Public</option><option value="1"<%- s.vip ? ' selected' : '' %>>VIP only</option></select>
                                                    <button class="btn btn-sm btn-success" type="submit">Save</button>
                                                </form>
                                            </details>
                                            <form action="/web/api/admin/servers" method="POST" class="mt-1">
                                                <input type="hidden" name="action" value="delete"/>
                                                <input type="hidden" name="id" value="<%= s.id %>"/>
                                                <button class="btn btn-sm btn-danger" type="submit">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('partials/dash-foot') %>
