{
    "name": "tech-website",
    "version": "4.0.0",
    "private": true,
    "packageManager": "pnpm@12.14.0",
    "engines": {
        "node": ">=24",
        "pnpm": ">=10"
    },
    "browserslist": [
        "chrome >= 49",
        "firefox >= 45",
        "safari >= 10",
        "edge >= 12",
        "ie 11"
    ],
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "build": "node scripts/build.mjs",
        "start": "node --env-file-if-exists=.env dist/server.js",
        "check": "tsc -p tsconfig.json && eslint . && pnpm audit --audit-level=moderate",
        "test": "node --import tsx --import ./tests/setup-env.ts --test tests/unit/*.test.ts",
        "parity": "node tests/parity.mjs",
        "bench": "node scripts/bench.mjs",
        "smoke": "node scripts/smoke.mjs",
        "lint": "eslint .",
        "format": "prettier --write .",
        "db:init": "node -e \"const{mkdirSync,existsSync}=require('fs');const D=require('better-sqlite3');if(!existsSync('prisma'))mkdirSync('prisma');new D('prisma/main.db').close();new D('prisma/web.db').close();\" && pnpm exec drizzle-kit push --config=drizzle.main.config.ts --force && pnpm exec drizzle-kit push --config=drizzle.web.config.ts --force",
        "db:clear": "node -e \"const{rmSync}=require('fs');rmSync('prisma/main.db',{force:true});rmSync('prisma/web.db',{force:true});\" && pnpm run db:init",
        "db:seed": "pnpm exec tsx prisma/seed-main.ts && pnpm exec tsx prisma/seed-web.ts",
        "db:reset": "pnpm run db:clear && pnpm run db:seed",
        "setup": "pnpm exec tsx scripts/setup-admin.ts",
        "check:views": "pnpm exec tsx tests/views-smoke.ts",
        "db:migrate": "pnpm exec drizzle-kit generate --config=drizzle.main.config.ts && pnpm exec drizzle-kit generate --config=drizzle.web.config.ts",
        "check:full": "pnpm run check && pnpm test && pnpm run check:views && pnpm run check:hot",
        "check:hot": "pnpm exec tsx tests/hot-reload.ts"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "better-sqlite3": "^13.1.1",
        "drizzle-orm": "^0.45.4",
        "ejs": "^6.0.1",
        "stripe": "^22.6.2",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@types/better-sqlite3": "^9.6.0",
        "@types/ejs": "^3.1.5",
        "@types/node": "^24.0.0",
        "autoprefixer": "^10.4.21",
        "drizzle-kit": "^0.31.10",
        "esbuild": "^0.28.2",
        "eslint": "^9.0.0",
        "postcss": "^8.5.6",
        "prettier": "^3.9.6",
        "tsx": "^4.23.12",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.0.0"
    }
}
