{
    "name": "tech-website",
    "version": "4.0.0",
    "private": true,
    "packageManager": "pnpm@12.14.0",
    "engines": {
        "node": ">=24",
        "pnpm": ">=10"
    },
    "browserslist": [
        "chrome >= 49",
        "firefox >= 45",
        "safari >= 10",
        "edge >= 12",
        "ie 11"
    ],
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "build": "node scripts/build.mjs",
        "start": "node --env-file-if-exists=.env scripts/start.mjs",
        "check": "tsc -p tsconfig.json && eslint . && pnpm audit --audit-level=moderate",
        "test": "node --import tsx --import ./tests/setup-env.ts --test tests/unit/*.test.ts",
        "parity": "node tests/parity.mjs",
        "bench": "node scripts/bench.mjs",
        "smoke": "node scripts/smoke.mjs",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "db:init": "node scripts/db-init.mjs",
        "db:clear": "node scripts/db-clear.mjs && pnpm run db:init",
        "db:seed": "pnpm exec tsx scripts/seed-main.ts && pnpm exec tsx scripts/seed-web.ts",
        "db:reset": "pnpm run db:clear && pnpm run db:seed",
        "setup": "pnpm exec tsx scripts/setup-admin.ts",
        "check:views": "node --import tsx --import ./tests/setup-env.ts tests/views-smoke.ts",
        "db:migrate": "pnpm exec drizzle-kit generate --config=drizzle.main.config.ts && pnpm exec drizzle-kit generate --config=drizzle.web.config.ts",
        "check:full": "pnpm run check && pnpm test && pnpm run check:views && pnpm run check:hot",
        "check:hot": "node --import tsx --import ./tests/setup-env.ts tests/hot-reload.ts",
        "check:seo": "node scripts/check-seo.mjs",
        "check:flows": "node scripts/check-flows.mjs",
        "check:contrast": "node --import tsx --test tests/unit/contrast.test.ts"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "better-sqlite3": "^13.2.0",
        "drizzle-orm": "^0.45.4",
        "ejs": "^7.0.2",
        "sharp": "^0.35.5",
        "stripe": "^23.2.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/better-sqlite3": "^9.6.0",
        "@types/ejs": "^3.1.5",
        "@types/node": "^26.6.6",
        "autoprefixer": "^10.7.0",
        "drizzle-kit": "^0.31.11",
        "esbuild": "^0.28.2",
        "eslint": "^10.15.0",
        "postcss": "^8.5.33",
        "prettier": "^3.10.1",
        "tsx": "^4.23.15",
        "typescript": "5.9.3",
        "typescript-eslint": "^8.73.0"
    }
}
